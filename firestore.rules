rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // User's Favorite Venues Subcollection
      match /favorites/{venueId} {
        allow read, write: if isOwner(userId);
      }

      // User's Friends Subcollection
      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Hangout Alerts / Live Beacons
    match /hangouts/{hangoutId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(hangoutId);
      allow update: if isSignedIn() 
        && (resource.data.userId == request.auth.uid 
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantsCount', 'joinedUsers', 'status', 'updatedAt']));
      allow delete: if isSignedIn() 
        && resource.data.userId == request.auth.uid;
    }

    // Chat threads & messages
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() 
          && request.resource.data.senderId == request.auth.uid
          && isValidId(messageId);
        allow update, delete: if isSignedIn() 
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
